# ====================================================================
# Sabro Networks FTTH - Enterprise ISP Environment Configuration
# Copy this file to .env and configure your production values
# ====================================================================

# Cryptographic Session & CSRF Key
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-character-hex-secret-in-production

# Server Host & Port
HOST=0.0.0.0
PORT=5000

# Environment Mode (production / development)
FLASK_ENV=production

# Database Path (Defaults to ./sabro_isp.db if left unset)
SABRO_DB_PATH=sabro_isp.db
